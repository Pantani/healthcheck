{
    "name": "Services Health Check",
    "description": "Scheduled HTTP health checks with Redis-backed state and PagerDuty incidents",
    "keywords": [
        "monitoring",
        "healthcheck"
    ],
    "website": "https://github.com/Pantani/healthcheck",
    "repository": "https://github.com/Pantani/healthcheck",
    "logo": "https://avatars0.githubusercontent.com/u/32179889",
    "success_url": "/",
    "formation": {
        "worker": {
            "quantity": 1,
            "size": "basic"
        }
    },
    "addons": [
        {
            "plan": "heroku-redis:hobby-dev",
            "as": "REDIS"
        }
    ],
    "buildpacks": [
        {
            "url": "heroku/go"
        }
    ],
    "env": {
        "PAGERDUTY_KEY": {
            "description": "PagerDuty Access Key.",
            "required": true
        },
        "PAGERDUTY_ESCALATION_POLICY": {
            "description": "PagerDuty Escalation Policy ID.",
            "required": true
        },
        "PAGERDUTY_SERVICE": {
            "description": "PagerDuty Service ID.",
            "required": true
        },
        "HEALTHCHECK_HTTP_TIMEOUT": {
            "description": "HTTP timeout as a Go duration.",
            "required": false,
            "value": "15s"
        }
    }
}
